{
  "name": "auto-staff",
  "version": "0.4.0",
  "description": "Unified CLI for autonomous automation - code, text, and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "auto-staff": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chalk": "catalog:",
    "commander": "catalog:",
    "ora": "catalog:",
    "@varlinor/autostaff-core": "workspace:*",
    "auto-code": "workspace:*",
    "auto-text": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/varlinor/autostaff"
  },
  "keywords": [
    "ai",
    "agent",
    "autonomous",
    "coding",
    "writing",
    "opencode"
  ],
  "author": "varlinor",
  "license": "MIT"
}
